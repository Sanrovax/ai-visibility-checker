# Copy these into Vercel: Project > Settings > Environment Variables
# Never put real keys in this file or in GitHub.

# Required: Google Gemini API key (from aistudio.google.com)
GEMINI_API_KEY=

# Optional: Gemini model to use. Change only if Google retires this name.
GEMINI_MODEL=gemini-3.8-flash

# Optional: Supabase, to save leads (name, email, phone) from the "Unlock full report" form.
# If left empty, leads are printed in Vercel logs instead of being saved.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: where the "Book a free 15-min call" button goes.
NEXT_PUBLIC_BOOKING_URL=https://sanrovax.com

# Optional: cost protection (per server instance, best effort)
CHECKS_PER_IP_PER_DAY=3
CHECKS_PER_DAY_TOTAL=150

# Testing only: set to true to return fake results without calling Gemini.
# Never set this to true on the live site.
MOCK_MODE=false
